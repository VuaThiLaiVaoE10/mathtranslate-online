rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structure for the
// MathTranslate Key Dashboard:
//
// Collection: users
// Document ID: {userId} (must match authenticated Firebase Auth UID, 1..128 chars)
// Fields (strict schema via hasOnly; no extraneous fields permitted):
//   - email: string (optional, 0..254 chars) - Authenticated user's email address
//   - keysByEngine: map (optional, max 3 entries) - Per-engine API key settings
//       Allowed keys: 'gemini', 'openai', 'deepl'
//       Each engine entry is a map containing only optional string fields:
//         - key1: string (optional, 0..512 chars) - Primary API key
//         - key2: string (optional, 0..512 chars) - Secondary API key
//         - baseUrl: string (optional, 0..512 chars) - Custom API base URL
//   - updatedAt: timestamp or number (required, >= 0 when number) - Last update time
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Verify that the request comes from an authenticated Firebase Auth user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verify path-based document ownership against the caller's Auth UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate document ID length bounds
    function isBoundedId(idVal, minLen, maxLen) {
      return idVal is string &&
        idVal.size() >= minLen &&
        idVal.size() <= maxLen;
    }

    // Validate that all required fields exist on the map
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    // Enforce strict schema (reject any extraneous/unexpected fields)
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    // Validate an optional string field within a map, enforcing type and max length
    function isValidOptionalStringInMap(mapData, field, maxLen) {
      return !(field in mapData) ||
        (mapData[field] is string && mapData[field].size() <= maxLen);
    }

    // Validate updatedAt as a Firestore timestamp or non-negative epoch number
    function isValidTimestampOrNumber(val) {
      return val is timestamp || (val is number && val >= 0);
    }

    // ===============================================================
    // Domain Validators (Applied on BOTH create and update)
    // ===============================================================

    // Validate a single engine entry inside keysByEngine
    function isValidEngineKeyConfig(entry) {
      return entry is map &&
        entry.keys().hasOnly(['key1', 'key2', 'baseUrl']) &&
        isValidOptionalStringInMap(entry, 'key1', 512) &&
        isValidOptionalStringInMap(entry, 'key2', 512) &&
        isValidOptionalStringInMap(entry, 'baseUrl', 512);
    }

    // Validate the keysByEngine map (only 'gemini', 'openai', 'deepl' keys allowed)
    function isValidKeysByEngine(keysMap) {
      return keysMap is map &&
        keysMap.keys().hasOnly(['gemini', 'openai', 'deepl']) &&
        keysMap.size() <= 3 &&
        (!('gemini' in keysMap) || isValidEngineKeyConfig(keysMap.gemini)) &&
        (!('openai' in keysMap) || isValidEngineKeyConfig(keysMap.openai)) &&
        (!('deepl' in keysMap) || isValidEngineKeyConfig(keysMap.deepl));
    }

    // Validate the full users/{userId} document on create and update
    function isValidUserKeyDoc(data) {
      let allowedFields = ['email', 'keysByEngine', 'updatedAt'];
      return data is map &&
        hasOnlyAllowedFields(data, allowedFields) &&
        hasRequiredFields(data, ['updatedAt']) &&
        isValidOptionalStringInMap(data, 'email', 254) &&
        (!('keysByEngine' in data) || isValidKeysByEngine(data.keysByEngine)) &&
        isValidTimestampOrNumber(data.updatedAt);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // User key dashboard document: strictly private to the authenticated owner.
    // Single-document get/create/update/delete allowed; collection list queries denied.
    match /users/{userId} {
      allow get, delete: if isOwner(userId) && isBoundedId(userId, 1, 128);
      allow list: if false;

      allow create: if isOwner(userId) &&
        isBoundedId(userId, 1, 128) &&
        isValidUserKeyDoc(request.resource.data);

      allow update: if isOwner(userId) &&
        isBoundedId(userId, 1, 128) &&
        isValidUserKeyDoc(request.resource.data);
    }

    // Explicit default-deny fallback for all unmatched paths and subcollections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
